# Server
#
# This file is the template for THREE real files, all gitignored:
#   .env              loaded always (dotenv-flow); the base/shared config
#   .env.development   layered on top of .env when NODE_ENV=development
#   .env.production    layered on top of .env when NODE_ENV=production
# `pnpm dev`/`start:dev` set NODE_ENV=development and `pnpm start` sets
# NODE_ENV=production (via cross-env, so it works the same on Windows). A key only
# needs to exist in the env-specific file if its value actually differs there.
PORT=5000
NODE_ENV=development

# URL of your frontend application (used for CORS)
FRONTEND_URL=http://localhost:5173

# URL of the admin panel, used for CORS + Better Auth trusted origins
ADMIN_URL=http://localhost:5180

# MongoDB connection string
# Note: MongoDB reserves the database names `local`, `admin` and `config` —
# writes against them fail because they cannot join a transaction.
DATABASE_URL="mongodb://localhost:27017/upasana"

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------

# Your product's name and marketing site. Used in transactional emails
# (src/lib/email-templates.ts) and the Swagger page title. Set these first —
# the defaults say "Acme".
BRAND_NAME=Upasana
SITE_URL=http://localhost:5173

# The logo shown in email headers. Must be a PNG on a public URL — Gmail strips
# `data:` sources and no major mail client renders SVG. Defaults to
# <SITE_URL>/email/mark.png.
BRAND_MARK_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Better Auth — generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL is this server's own origin; Better Auth serves its routes under
# /api/auth beneath it and builds OAuth callback URLs from it.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave unset to run with email/password sign-in only.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# Resend — dashboard → API Keys. Sends the password-reset link and the welcome
# email. Without this set, password reset fails and signup still succeeds (the
# welcome email is a logged miss, never a blocked account — see src/lib/auth.ts).
RESEND_API_KEY=replace-me

# Must be on a domain verified in the Resend dashboard, or sending fails at
# request time. Until a domain is verified, Resend's own onboarding@resend.dev
# works but only delivers to the email address the Resend account itself was
# signed up with — fine for local testing, not for real users.
RESEND_FROM_EMAIL=Upasana <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# WhatsApp (MSG91)
# ---------------------------------------------------------------------------

# MSG91 — dashboard → Authkey. Sends team invites and the registration form's
# verification codes on WhatsApp. Without it (or while it is replace-me) mobile
# invites still work — the admin gets the link and shares it themselves — and
# verification codes are printed to the server log in development; production
# refuses to send them. setup.md → "WhatsApp (MSG91)" has the full
# setup, including the template wording Meta has to approve.
MSG91_AUTH_KEY=replace-me

# The WhatsApp number connected in MSG91, with country code, e.g. 919876543210.
MSG91_WHATSAPP_NUMBER=

# MSG91 → WhatsApp → Templates shows this beside each template. Leave empty if
# MSG91 does not ask for it.
MSG91_WHATSAPP_NAMESPACE=

# The language the templates were approved in.
MSG91_WHATSAPP_LANGUAGE=en

# Template names as approved. Only change these if MSG91 made you pick another.
MSG91_TEMPLATE_INVITE=team_invite
MSG91_TEMPLATE_OTP=registration_otp
MSG91_TEMPLATE_STAY=room_details

# Most verification codes sent per hour across all numbers — a cap on what a
# script hammering the public registration form can spend. Default 500.
OTP_MAX_PER_HOUR=500

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Anthropic — powers src/lib/ai/claude.ts. Every call is metered into the
# `usage_event` collection, so you can see what a user costs before the invoice
# does. Optional: the app boots without it.
ANTHROPIC_API_KEY=

# Google AI Studio — powers src/lib/ai/gemini.ts, the cheap bulk-call client.
# Optional.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# Set to 1 to log every Prisma query. Off by default — the worker polls the job
# collection every five seconds, and unconditional query logging buries every
# real line under hundreds of aggregate pipelines.
PRISMA_LOG_QUERIES=0